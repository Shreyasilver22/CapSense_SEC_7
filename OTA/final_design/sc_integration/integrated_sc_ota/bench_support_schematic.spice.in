.include "@SCL08_MODELS@/mos/tntp49_5v"
.include "@SCL08_MODELS@/res/typ/ppr"
.temp 27
.options reltol=4e-4 vntol=3u abstol=1e-11 numdgt=12 method=gear maxord=2
VDD vdd 0 5
VCLK clk10k 0 PULSE(0 5 0 1u 1u 49u 100u)
VOTA vdd ota_vdd 0
VREFSRC ref_src 0 2.5
VREFSENSE ref_src vref 0
XCLK clk10k d0 d1 d2 clk_vdd 0 phi1 phi1b phit phitb phi2 phi2b pr prb tr trb chg chgb phase_trim08 
.include "models/blocks.spice"
VCLKDD vdd clk_vdd 0
VTRIM0 d0 0 5
VTRIM1 d1 0 5
VTRIM2 d2 0 0
.include "models/ota_bias.spice"
VBIASDD vdd bias_vdd 0
XB ref_src bias_vdd 0 vbn vbp bias_src ota_bias08
VIREF bias_src bias 0
VEXC vp 0 5
RLEAKP sensp 0 1e12
RLEAKN sensn 0 1e12
.save v(outp) v(outn) v(sump) v(sumn) v(txp) v(txn) v(rxp) v(rxn) v(sensp) v(sensn) v(phi1) v(phi2) v(phit)
.options klu method=trap reltol=4e-4 trtol=10
.tran 80n 395u 0 80n
.subckt corrected_tg A B PHI PHIB VDD VSS
MN A PHI B VSS N W=10u L=0.8u AD=45p AS=45p PD=29u PS=29u
MP A PHIB B VDD P W=20u L=0.8u AD=90p AS=90p PD=49u PS=49u
.ends corrected_tg
.subckt corrected_pmos_bank SUM OUT
MFB SUM OUT SUM SUM P W=20u L=10u M=121 AD=90p AS=90p PD=49u PS=49u
.ends corrected_pmos_bank
