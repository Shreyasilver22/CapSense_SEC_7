.subckt ota_input_cm_servo sump sumn vdd phi1 phi2 phit
*.iopin vdd
*.iopin phit
*.iopin phi1
*.iopin phi2
*.iopin sump
*.iopin sumn
BICMERR 0 cm_acc I = 1m*v(cm_sample)*(2.5-(v(sump)+v(sumn))/2)
CICMINT cm_acc 0 1n m=1
RICMINT cm_acc 0 1e13 m=1
VICMSAMPLE cm_sample 0 PULSE(0 1 84u 10n 10n 2u 100u)
BICMCTRL cm_ctrl 0 V = max(0,min(v(vdd),2.5+v(cm_acc)))
XSICMHOLD cm_ctrl cm_hold phi1 vdd user_tg_control
CICMHOLD cm_hold 0 20p m=1
RICMHOLD cm_hold cm_init 1e13 m=1
VICMINIT cm_init 0 2.5
XSICMEDGE1 vdd cm_edge1 phit vdd user_tg_control
XSICMRST1 0 cm_edge1 phi1 vdd user_tg_control
CICMEDGE1 cm_edge1 0 10p m=1
XSICMEDGE2 vdd cm_edge2 phi2 vdd user_tg_control
XSICMRST2 0 cm_edge2 phi1 vdd user_tg_control
CICMEDGE2 cm_edge2 0 10p m=1
BICMDRIVE cm_x 0 V = ((.68*v(cm_edge1)+.32*v(cm_edge2))/max(.1,v(vdd)))*v(cm_hold)
MCORRp sump cm_x sump sump P W=20u L=10u M=40 AD=90p AS=90p PD=49u PS=49u
MCORRn sumn cm_x sumn sumn P W=20u L=10u M=40 AD=90p AS=90p PD=49u PS=49u
