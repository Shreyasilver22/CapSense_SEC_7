.include "pdk.spice"
.include "models/vcr_low_total.spice"
.temp 27
.options reltol=4e-4 vntol=3u abstol=1e-11 numdgt=12 method=gear maxord=2
VDD vdd 0 PWL(0 0 10u 0 40u 5)
VCLKR ck_frac 0 PULSE(0 1 0 1u 1u 49u 100u)
BCLK clk10k 0 V=V(ck_frac)*V(vdd)
VOTA vdd ota_vdd 0
.include "models/switched_midrail08.spice"
.include "models/clocked_iref08.spice"
.include "models/clocked_iref_trim08.spice"
VREFGEN vdd refgen_vdd 0
VTR0 trim0 vdd 0
VTR1 trim1 vdd 0
VTR2 trim2 0 0
VTR3 trim3 0 0
VTR4 trim4 vdd 0
VTR5 trim5 vdd 0
VTR6 trim6 vdd 0
VTR7 trim7 0 0
XREFGEN refgen_vdd 0 clk10k ref_src bias_src trim0 trim1 trim2 trim3 trim4 trim5 trim6 trim7 bias_reference_trim08
VREFSENSE ref_src vref 0
XCLK clk10k d0 d1 d2 clk_vdd 0 phi1 phi1b phit phitb phi2 phi2b pr prb tr trb chg chgb cm_sample cm_sampleb phase_trim08
.include "models/clock_icm.spice"
VCLKDD vdd clk_vdd 0
VTRIM0 d0 vdd 0
VTRIM1 d1 vdd 0
VTRIM2 d2 0 0
.include "models/bias_with_vbn_vbp_only.spice"
VBIASDD vdd bias_vdd 0
XB ref_src bias_vdd 0 vbn vbp bias_src ota_bias08
VIREF bias_src bias 0
VEXC vp vdd 0
RLEAKP sensp 0 1e12
RLEAKN sensn 0 1e12
.save v(vdd) v(outp) v(outn) v(sump) v(sumn) v(ref_src) v(bias) v(pinp) v(pinn) v(adcp) v(adcn) v(phi1) v(phi2) v(phit) v(tr) v(pr) v(cm_sample) v(accum) i(vdd) i(vota) i(viref) i(vrefgen) i(vclkdd) i(vicmdd) i(vbiasdd) i(vrefhdd)
.options method=gear reltol=4e-4 trtol=10
.tran 180n @STOP_US@u 0 180n
.subckt corrected_tg A B PHI PHIB VDD VSS
MN A PHI B VSS N W=10u L=0.8u AD=45p AS=45p PD=29u PS=29u
MP A PHIB B VDD P W=20u L=0.8u AD=90p AS=90p PD=49u PS=49u
.ends corrected_tg
.subckt corrected_pmos_bank SUM OUT
MFB SUM OUT SUM SUM P W=20u L=10u M=60 AD=90p AS=90p PD=49u PS=49u
.ends corrected_pmos_bank
