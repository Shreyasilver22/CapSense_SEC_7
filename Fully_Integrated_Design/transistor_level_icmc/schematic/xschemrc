set design_dir [file normalize [file dirname [info script]]]
set standard_library /usr/share/xschem/xschem_library
if {[info exists env(XSCHEM_SYSTEM_LIBRARY)]} {
    set standard_library $env(XSCHEM_SYSTEM_LIBRARY)
}
set baseline [file normalize [file join $design_dir .. ..]]
if {[info exists env(CAPSENSE_INTEGRATED_DIR)]} {
    set baseline [file normalize $env(CAPSENSE_INTEGRATED_DIR)]
}
set icmc [file normalize [file join $design_dir .. .. .. ICMC]]
if {[info exists env(CAPSENSE_ICMC_DIR)]} {
    set icmc [file normalize $env(CAPSENSE_ICMC_DIR)]
}
set base_schematic [file join $baseline schematic]
set icmc_schematic [file join $icmc schematic]
set XSCHEM_LIBRARY_PATH "$design_dir:$icmc_schematic:$base_schematic:$base_schematic/symbols:$standard_library"
set netlist_dir [file join $design_dir netlist]
file mkdir $netlist_dir
set dark_colorscheme 0
set color_ps 1
